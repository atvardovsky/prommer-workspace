        "bare Alatyr request",
        "operation help",
        "ambiguous request"
      ],
      "context_profiles": [],
      "required_module": "core-profile",
      "flow": ".ai/assistant/flows/operation-routing.flow.md",
      "minimum_inputs": [
        "goal or suspected task area when known"
      ],
      "allowed_actions": [
        "read-only"
      ],
      "preview": "never",
      "aliases": [
        "Alatyr",
        "Alatyr help"
      ],
      "final_evidence": [
        "adapter state evidence status",
        "relevant operations",
        "next safe action"
      ]
    },
    {
      "id": "adapter-health",
      "title": "Adapter health",
      "summary": "Inspect current adapter structure and return prioritized repair routes without editing.",
      "use_when": [
        "adapter status",
        "adapter doctor",
        "suspected adapter breakage"
      ],
      "context_profiles": [
        "framework-upgrade"
      ],
      "required_module": "core-profile",
