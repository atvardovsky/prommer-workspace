      "allowed_actions": [
        "read-only"
      ],
      "preview": "never",
      "aliases": [
        "Alatyr status",
        "Alatyr doctor"
      ],
      "final_evidence": [
        "health state enum",
        "installation state",
        "acceptance eligibility",
        "checks run and unavailable",
        "up to three repair operations",
        "no files changed"
      ]
