{
  "schema_version": 1,
  "descriptor_kind": "target-context-profile",
  "profile": "architecture-change",
  "use_when": [
    "module boundary change",
    "dependency direction change",
    "runtime topology change",
    "public API or cross-component contract change"
  ],
  "operation_candidates": [
    "create-project-blueprint",
    "product-change",
    "logical-integrity-review",
    "engineering-evidence",
    "project-knowledge",
    "failure-analysis"
  ],
  "required_context": [
    ".ai/project/source-of-truth-registry.md",
    ".ai/assistant/gates/core.md",
    ".ai/assistant/gates/semantic-integrity.md",
    ".ai/assistant/gates/final-evidence.md",
    ".ai/project/contour.md"
  ],
  "conditional_context": [
    {
      "path": ".ai/framework/context-discovery.md",
      "when": "context selection expansion or missing-context handling is disputed"
    },
    {
      "path": ".ai/framework/change-risk-model.md",
      "when": "changed-fact risk classification or escalation is disputed"
    },
    {
      "path": ".ai/framework/logical-integrity.md",
      "when": "invariant derivation repair-set selection or semantic closure is ambiguous"
    },
    {
      "path": ".ai/framework/source-of-truth-registry.md",
      "when": "registry ownership semantics are disputed or the target registry requires repair"
    },
    {
      "path": ".ai/framework/approval-records.md",
      "when": "the proposed change crosses a protected architecture or dependency boundary"
    },
    {
      "path": ".ai/framework/security-safety-guidance.md",
      "when": "security privacy external service production or permission boundaries are affected"
    },
    {
      "path": ".ai/assistant/gates/security-approval.md",
      "when": "the change reaches a protected approval or security boundary"
    }
  ],
  "expand_when": [
    "data_ownership_changes",
    "external_boundary_changes",
    "security_boundary_changes",
    "new_dependency_or_service",
    "diagram_changes",
    "bridge_or_gate_changes"
  ],
  "approval_gates": [
    "architecture_change",
    "new_production_dependency_or_service"
  ],
  "validation": [
    "manual target review; architecture sources and automated checks are not yet available"
  ],
  "final_evidence": [
    "architecture_owner_update",
    "re_derived_invariants",
    "review_item_reconciliation",
    "affected_areas",
    "validation",
    "diagram_result",
    "contract_artifact_result",
    "visual_validation_result",
    "residual_risk"
  ]
}
